# --- Telegram ---
# Token from @BotFather
TG_BOT_TOKEN=123456:ABC-DEF...
# Hardcoded admin: the only one who can approve/block users and close polls.
TG_ADMIN_ID=123456789

# Optional proxy for the Telegram connection (empty = direct).
# Supports http / https / socks5. Credentials may be embedded in the URL
#   http://user:pass@host:port   or supplied separately below.
TG_PROXY_URL=
TG_PROXY_USER=
TG_PROXY_PASS=

# --- VK ---
# Community (group) access token with "messages" + "manage" rights.
VK_TOKEN=vk1.a.xxxxx
# Community id. Optional — auto-detected from the token if omitted/0.
VK_GROUP_ID=0
# Peer id of the chat to watch, e.g. 2000000001 (= 2000000000 + chat_id).
# Optional: 0 = react to every chat the community bot sees.
VK_PEER_ID=0

# --- Behaviour ---
# Comma-separated, case-insensitive substrings that trigger an @all broadcast.
MENTION_TAGS=@all,@все,@online
# How often active polls are re-synced from VK (seconds).
POLL_REFRESH_SEC=30
# Lifetime of a one-time VK link code (minutes).
LINK_CODE_TTL_MIN=30

# --- Storage ---
BOT_DB_PATH=/data/bot.db
